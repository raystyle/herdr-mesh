# herdr-mesh 部署环境(占位符;复制到 deploy/env 后填真值,永不提交)
#
# 代称约定(文档与脚本不出现真实主机名与 IP):
#   store-node : 存储宿主机(S3 garage + S2 s2-lite 容器所在)
#   node-a / node-b / ... : agent 节点(linux 或 mac)
# 各机以 SSH 别名可达(store-node、node-a 等),密钥互信已配。

# ---- 存储服务(store-node)----
STORE_NODE_SSH="store-node"           # 存储宿主 SSH 别名
GARAGE_RPC_SECRET="__openssl_rand_hex_32__"
GARAGE_ADMIN_TOKEN="__openssl_rand_hex_32__"
GARAGE_S3_PORT="3900"
GARAGE_ADMIN_PORT="3903"
S2_PORT="8090"
S2_BUCKET="s2-data"                   # s2-lite 后备桶(garage)
S2_PATH="s2lite"                      # s2-lite 数据前缀
BASIN_NAME="mesh-basin"               # 流 basin(>= 8 字节)

# ---- agent 节点 ----
AGENT_NODES="node-a node-b"           # 空格分隔;linux/mac 均可
S5_BUCKET="mesh-files"                # 文件交换桶
HERDR_PEERS="store-node node-b"       # 本节点要注册的对端 SSH 别名(每个节点各配)
TS_CONTROL_URL=""                     # 自托管控制面(tailscale up --login-server;留空用官方)

# ---- 可选覆盖 ----
# HERDR_BIN_URL=""                    # herdr 二进制直链(release 缺资产的平台用)
# HERDR_VERSION="0.9.3"               # herdr release 版本(linux 资产道)
# PRIM_SRC=""                         # prim 安装源(缺省 git+https://github.com/raystyle/herdr-mesh#subdirectory=src)
