# 存储栈 compose 环境(复制为 store.env 填真值;永不提交)
# garage 双密钥首起前生成:openssl rand -hex 32
GARAGE_RPC_SECRET=__gen__
GARAGE_ADMIN_TOKEN=__gen__
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
S2_PORT=8090
S2_BUCKET=s2-data            # s2-lite 后备桶(garage)
S2_PATH=s2lite               # s2-lite 数据前缀
# S2 专用钥由 garage-init.sh 产出后回填(首起 -> init -> 回填 -> up -d 再来一次)
S2_KEY_ID=
S2_KEY_SECRET=
